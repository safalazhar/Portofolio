# Konfigurasi Port Server (opsional, default 5000)
PORT=5000

# Konfigurasi SMTP Gmail (wajib - untuk kirim notifikasi pesan ke email Anda)
# PENTING: Gunakan "App Password" dari akun Google Anda, BUKAN password biasa!
# Cara membuat App Password:
#   1. Aktifkan 2-Step Verification di https://myaccount.google.com/security
#   2. Buat App Password di https://myaccount.google.com/apppasswords
#   3. Salin 16-digit password yang diberikan ke EMAIL_PASS
EMAIL_USER=msafalazhar@gmail.com
EMAIL_PASS=your-app-password-here

# Email penerima notifikasi pesan kontak
RECEIVER_EMAIL=msafalazhar@gmail.com
